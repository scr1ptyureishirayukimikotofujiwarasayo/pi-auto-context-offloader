{
  "name": "pi-auto-context-offloader",
  "version": "0.2.0",
  "description": "Pi extension that keeps conversations under a configurable token budget by offloading old turns to a file the model can recall and search.",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "context",
    "token-budget",
    "offload",
    "cost-reduction"
  ],
  "license": "MIT",
  "author": "scr1ptyureishirayukimikotofujiwarasayo",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^1.5.2",
    "@earendil-works/pi-ai": "^1.5.2",
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@types/node": "^22.0.0",
    "typebox": "^1.3.27",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/scr1ptyureishirayukimikotofujiwarasayo/pi-auto-context-offloader.git"
  },
  "bugs": {
    "url": "https://github.com/scr1ptyureishirayukimikotofujiwarasayo/pi-auto-context-offloader/issues"
  },
  "homepage": "https://github.com/scr1ptyureishirayukimikotofujiwarasayo/pi-auto-context-offloader#readme"
}
